# Copy to .env and adjust. Never put passwords or personal data here.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen3-coder-30b
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=400
LLM_FORCE_JSON_MODE=0
MODE=build
HEADLESS=false
MAX_TRIES_PER_STEP=8
MAX_ROUNDS_PER_COMPANY=60
SAME_ERROR_SWITCH=3
SAME_ERROR_ASK=5
OBSERVE_TOKEN_CAP=1500
PROMPT_TOKEN_CAP=3500
DEBUG_PROMPTS=0
