<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Build report — {{ company }}</title>
<style>
  body{font-family:system-ui,sans-serif;max-width:1000px;margin:2rem auto;padding:0 1rem;color:#222}
  h1{margin-bottom:.2rem} .status{font-weight:700;padding:.2rem .6rem;border-radius:.4rem;color:#fff}
  .DONE{background:#1b7f3b} .STOP{background:#b00020} .ASK{background:#c77700}
  table{border-collapse:collapse;margin:1rem 0} td,th{border:1px solid #ccc;padding:.3rem .6rem;text-align:left}
  pre{background:#f6f6f6;padding:.8rem;overflow:auto;font-size:.85rem}
  .flag{color:#8a5a00}
</style>
</head>
<body>
<h1>{{ company }} <span class="status {{ status }}">{{ status }}</span></h1>
<p>{{ reason }} · generated {{ generated }}</p>

<h2>Summary</h2>
<table>
<tr><th>Samples</th><td>{{ metrics.samples_passed }}/{{ metrics.samples_total }}</td>
    <th>Rounds</th><td>{{ metrics.rounds_total }}</td>
    <th>Steps</th><td>{{ metrics.steps_total }}</td></tr>
<tr><th>First-try pass rate</th><td>{{ metrics.first_try_pass_rate }}</td>
    <th>Tries / step (median, max)</th><td>{{ metrics.tries_per_step_median }}, {{ metrics.tries_per_step_max }}</td>
    <th>Fixes</th><td>{{ metrics.fix_count }}</td></tr>
<tr><th>Tokens in / out</th><td>{{ metrics.tok_in_total }} / {{ metrics.tok_out_total }}</td>
    <th>tok_in p95 · tok_out max</th><td>{{ metrics.tok_in_p95 }} · {{ metrics.tok_out_max }}</td>
    <th>Wall clock (s)</th><td>{{ metrics.seconds_wall }} ({{ metrics.seconds_wall_excluding_human }} excl. human)</td></tr>
<tr><th>Regressions undone / open</th><td>{{ metrics.regressions_undone }} / {{ metrics.regressions_open }}</td>
    <th>Submit presses / blocked</th><td>{{ metrics.submit_presses }} / {{ metrics.submit_blocked }}</td>
    <th>Secret hits</th><td>{{ metrics.secret_hits }}</td></tr>
</table>

<h2>Samples</h2>
{% if check %}
<p>Status: <b>{{ check.status }}</b> {{ check.passed }}/{{ check.total }}{% if check.error %} — stage {{ check.stage }}{% if check.step %}, {{ check.step }}{% endif %}: <code>{{ check.error }}</code>{% endif %}</p>
{% else %}<p>No full test ran.</p>{% endif %}

<h2>Steps</h2>
<table><tr><th>Step</th><th>Tries</th></tr>
{% for s in steps %}<tr><td>{{ s }}</td><td>{{ tries.get(s, 0) }}</td></tr>{% endfor %}
</table>

<h2>Flags</h2>
{% if flags %}
<ul>{% for f in flags %}<li class="flag">Left empty (no profile key): <b>{{ f.label }}</b> ({{ f.kind }}{% if f.section %}, {{ f.section }}{% endif %})</li>{% endfor %}</ul>
{% else %}<p>None.</p>{% endif %}

<h2>Diff</h2>
<pre>{{ diff }}</pre>

<h2>Log summary</h2>
<pre>{{ md }}</pre>

<h2>Metrics</h2>
<pre id="metrics">{{ metrics_json }}</pre>
{% if secret_hits %}<h2>Secret scan</h2><ul>{% for h in secret_hits %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
</body>
</html>
